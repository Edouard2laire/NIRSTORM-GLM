function plot_ACF_residual(ax, model, data, fit)
    
    maxlag = 100;
    betas = double(fit.stan_variable('beta_orig'));
    residual = data' - model.X * betas';

    lags = (0:maxlag)';
    A = acf_rows(residual', maxlag);

    prediction = mean(A);
    CI =  prctile(prediction, [2.5 97.5], 1);

    hold(ax, 'on')
    p = plot(ax, lags, prediction);
    
    X_fill = [lags, fliplr(lags)];
    Y_fill = [CI(1,:), fliplr(CI(2,:))];
    
    fill(X_fill, Y_fill, 'r', 'FaceAlpha', 0.3, 'EdgeColor', 'none', 'FaceColor', p.Color);
    hold(ax, 'off')
end